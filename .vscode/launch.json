{
    "configurations": [
        {
        "name": "TS-Node",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "${workspaceRoot}\\2025\\node_modules\\.bin\\ts-node",
        "runtimeArgs": [
          "--transpile-only"
        ],
        "program": "${file}",
        "cwd": "${fileDirname}",
        "internalConsoleOptions": "openOnSessionStart",
        "skipFiles": ["<node_internals>/**", "node_modules/**"]
      },
      {
        "type": "cppdbg",
        "request": "launch",
        "name": "Debug Fortran Program",
        "program": "${workspaceFolder}/bin/fortran/${fileBasenameNoExtension}",
        "stopAtEntry": true,
        "preLaunchTask": "build-fortran",
        "cwd": "${workspaceFolder}",
        "externalConsole": false
      }
    ],
    "inputs": [
    ]
  }